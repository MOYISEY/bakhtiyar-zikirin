{
  "head": "\n  <meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style id=\"theme-tokens\">:root{--paper:#f3f0e8;--ink:#172223;--teal:#23615b;--red:#bb3d25;--line:#c8cec3;--muted:#59675f;--surface:#ebece2;--hover:#d9e0d4;--panel:#e0e5d6;--panel-line:#b4bdab;--panel-ink:#172223;--panel-muted:#475d4d;--contact:#d9e2d4;--contact-line:#a6b7a1;--contact-muted:#435a49;--entity-bg:#23615b;--entity-ink:#f3f0e8;--entity-muted:#d1dfd1;--entity-line:#8bab99;--entity-card:#d6e2cf;--entity-card-ink:#172223;--grid:#d5dbcf55;color-scheme:light;background:var(--paper);color:var(--ink)}html[data-theme=dark]{--paper:#121b1a;--ink:#edf1e8;--teal:#9dd2bc;--red:#ff9d81;--line:#43564c;--muted:#aebfb3;--surface:#1b2824;--hover:#2c4036;--panel:#233b32;--panel-line:#5b7867;--panel-ink:#edf1e8;--panel-muted:#bdcdbd;--contact:#24392f;--contact-line:#66836e;--contact-muted:#cad8c8;--entity-bg:#213d34;--entity-ink:#eef2e9;--entity-muted:#c2d1c3;--entity-line:#779784;--entity-card:#3e5c48;--entity-card-ink:#f0f3ed;--grid:#71877833;color-scheme:dark}html[data-locale-pending=true] body{visibility:hidden}@media(prefers-color-scheme:dark){html:not([data-theme]){--paper:#121b1a;--ink:#edf1e8;--teal:#9dd2bc;--red:#ff9d81;--line:#43564c;--muted:#aebfb3;--surface:#1b2824;--hover:#2c4036;--panel:#233b32;--panel-line:#5b7867;--panel-ink:#edf1e8;--panel-muted:#bdcdbd;--contact:#24392f;--contact-line:#66836e;--contact-muted:#cad8c8;--entity-bg:#213d34;--entity-ink:#eef2e9;--entity-muted:#c2d1c3;--entity-line:#779784;--entity-card:#3e5c48;--entity-card-ink:#f0f3ed;--grid:#71877833;color-scheme:dark}}</style>\n<script>(()=>{const root=document.documentElement;let prefs={language:'ru',theme:'system'};try{const p=JSON.parse(localStorage.getItem('portfolio.preferences.v1')||'null');if(p&&['ru','kk','en'].includes(p.language))prefs.language=p.language;if(p&&['system','light','dark'].includes(p.theme))prefs.theme=p.theme}catch{}root.dataset.theme=prefs.theme==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):prefs.theme;root.dataset.themePreference=prefs.theme;root.lang=prefs.language;if(prefs.language!=='ru'){root.dataset.localePending='true';setTimeout(()=>{if(root.dataset.localePending){delete root.dataset.localePending;root.lang='ru'}},1500)}})();</script>\n  \n  <meta name=\"theme-color\" content=\"#f3f0e8\">\n  <meta name=\"description\" content=\"Бахтияр Зикирин, frontend-разработчик из Астаны. React, TypeScript, API. Проекты, опыт разработки и проверка поведения приложений.\" data-i18n-attrs=\"[{&quot;attr&quot;:&quot;content&quot;,&quot;key&quot;:&quot;s206&quot;}]\">\n  <meta property=\"og:title\" content=\"Бахтияр Зикирин — frontend-разработчик\" data-i18n-attrs=\"[{&quot;attr&quot;:&quot;content&quot;,&quot;key&quot;:&quot;s207&quot;}]\"><meta property=\"og:description\" content=\"Интерфейсы, логика и данные. Проекты и опыт разработки.\" data-i18n-attrs=\"[{&quot;attr&quot;:&quot;content&quot;,&quot;key&quot;:&quot;s208&quot;}]\"><meta property=\"og:type\" content=\"website\">\n  <title data-i18n-nodes=\"[{&quot;index&quot;:0,&quot;key&quot;:&quot;s207&quot;}]\">Бахтияр Зикирин — frontend-разработчик</title><link rel=\"icon\" type=\"image/svg+xml\" href=\"./favicon.svg\">\n",
